# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------
# Large / generated artifacts — never commit these
# ---------------------------------------------------------------

# Build output (any depth, not just the repo root)
build/
**/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Gradle
.gradle/
**/.gradle/
android/.gradle/
android/captures/
android/local.properties
android/key.properties
android/app/.cxx/
gradle-app.setting
.gradletasknamecache

# Compiled binaries & packages
*.apk
*.aab
*.aar
*.ap_
*.dex
*.jar
*.so
*.war
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Signing material — keep private keys out of git
*.jks
*.keystore
*.p12
*.pem

# Native symbols / obfuscation maps
*.symbols
*.map.json
**/android/**/obj/

# IDE / tooling caches
.idea/
.vscode/
*.iml
.qodo/
.cxx/

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
